#cloud-config
hostname: ${hostname}
preserve_hostname: false
manage_etc_hosts: true
timezone: ${timezone}
disable_root: true
ssh_pwauth: false
manage_resolv_conf: true
resolv_conf:
  nameservers:
%{ for dns_server in dns_servers ~}
    - ${dns_server}
%{ endfor ~}
users:
  - default
  - name: alpine
    groups:
      - wheel
    shell: /bin/ash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
%{ for ssh_public_key in ssh_public_keys ~}
      - ${ssh_public_key}
%{ endfor ~}
package_update: true
package_upgrade: false
packages:
  - haproxy
  - keepalived
  - keepalived-openrc
  - openssh
  - qemu-guest-agent
  - qemu-guest-agent-openrc
  - sudo
write_files:
  - path: /usr/local/sbin/console-autologin
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh
      exec /bin/login -f alpine
  - path: /etc/keepalived/keepalived.conf
    owner: root:root
    permissions: "0644"
    content: |
      global_defs {
        enable_script_security
      }

      vrrp_script check_haproxy {
        script "/bin/pidof haproxy"
        interval 2
        fall 2
        rise 2
      }

      vrrp_instance haproxy_vip {
        state BACKUP
        interface eth0
        virtual_router_id 20
        priority ${vrrp_priority}
        advert_int 1
        unicast_src_ip ${ipv4_address}
        unicast_peer {
          ${peer_ipv4_address}
        }
        virtual_ipaddress {
          ${floating_ipv4_address}/${network_prefix_length} dev eth0
        }
        track_script {
          check_haproxy
        }
      }
  - path: /etc/haproxy/haproxy.cfg
    owner: root:root
    permissions: "0644"
    content: |
      global
        log stdout format raw local0
        maxconn 1024

      defaults
        log global
        mode tcp
        option tcplog
        timeout connect 5s
        timeout client 1m
        timeout server 1m

%{ for port in tcp_ports ~}
      frontend incoming_${port}
        bind :${port}
        default_backend traefik_${port}

      backend traefik_${port}
        option tcp-check
        server traefik ${traefik_ip}:${port} check

%{ endfor ~}
runcmd:
  - |
    sed -i '/^tty1::respawn:/s@.*@tty1::respawn:/sbin/getty -n -l /usr/local/sbin/console-autologin 38400 tty1@' /etc/inittab
    kill -HUP 1
  - rc-update add haproxy default
  - rc-update add keepalived default
  - rc-update add qemu-guest-agent default
  - rc-update add sshd default
  - rc-service qemu-guest-agent start
  - rc-service sshd start
  - haproxy -c -f /etc/haproxy/haproxy.cfg
  - rc-service haproxy restart
  - rc-service keepalived restart
final_message: Alpine HAProxy edge bootstrap completed after $UPTIME seconds
