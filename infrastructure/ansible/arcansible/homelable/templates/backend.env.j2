AUTH_MODE='oidc'
AUTH_PASSWORD_HASH=''
OIDC_CLIENT_ID='homelable'
OIDC_DISCOVERY_URL='{{ homelable_authentik_origin }}/application/o/homelable/.well-known/openid-configuration'
