SECRET_KEY='{{ vault_homelable_secret_key }}'
OIDC_CLIENT_SECRET='{{ vault_homelable_oidc_client_secret }}'
MCP_SERVICE_KEY='{{ vault_homelable_mcp_service_key }}'
SQLITE_PATH='/app/data/homelab.db'
