---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeToggle.astro';

import antalosLogo from '../logoantalos.png';

---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a class="antalos-brand" href="/" aria-label="antalos documentation home">
      <img
        src={antalosLogo.src}
        width="2172"
        height="724"
        alt="antalos"
        loading="eager"
        decoding="async"
      />
    </a>
  </div>
  <div class="search-group">
    <Search />
  </div>
  <div class="header-actions">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--sl-color-border-default);
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .antalos-brand {
    text-decoration: none;
  }

  .antalos-brand img {
    height: 3rem;
    width: auto;
  }

  .sl-flex,
  .search-group,
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .search-group {
    justify-self: center;
  }

  .header-actions {
    justify-self: end;
  }

  @media (max-width: 767px) {
    .header {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding: 1rem;
    }

    .search-group {
      order: 3;
      width: 100%;
      justify-content: center;
    }

    .header-actions {
      margin-inline-start: auto;
    }
  }

  @media print {
    .search-group,
    .header-actions {
      display: none;
    }
  }
</style>
