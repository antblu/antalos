---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from './ThemeToggle.astro';

import antalosLogo from '../logoantalos.png';

---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a class="antalos-brand" href="/" aria-label="Antalos documentation home">
      <img
        src={antalosLogo.src}
        width="2172"
        height="724"
        alt="Antalos"
        loading="eager"
        decoding="async"
      />
    </a>
  </div>
  <div class="sl-flex print:hidden">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--sl-color-border-default);
  }

  .title-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .antalos-brand {
    text-decoration: none;
  }

  .antalos-brand img {
    height: 3rem;
    width: auto;
  }

  .sl-flex {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .print:hidden {
    display: none;
  }

  .sl-hidden {
    display: none;
  }

  @media (min-width: 768px) {
    .sl-hidden.md:sl-flex {
      display: flex;
    }
  }

  .print:hidden.right-group {
    display: none;
  }
</style>
