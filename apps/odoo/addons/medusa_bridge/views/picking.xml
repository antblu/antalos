<odoo>
  <record id="picking_medusa_bridge" model="ir.ui.view">
    <field name="name">stock.picking.medusa.bridge</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Medusa fulfillment" groups="medusa_bridge.group_medusa_bridge">
          <field name="medusa_fulfillment_id"/>
          <field name="medusa_carrier"/>
          <field name="medusa_tracking_number"/>
          <field name="medusa_tracking_url"/>
          <field name="medusa_delivery_confirmed"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
