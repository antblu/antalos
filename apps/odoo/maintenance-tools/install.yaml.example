# Manual maintenance template; not discovered by Argo CD.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: odoo-cal-diy-maintenance
  namespace: argocd
rules:
- apiGroups:
  - argoproj.io
  resources:
  - applications
  resourceNames:
  - odoo
  verbs:
  - get
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: odoo-cal-diy-maintenance
  namespace: argocd
subjects:
- kind: ServiceAccount
  name: odoo-bootstrap
  namespace: odoo
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: odoo-cal-diy-maintenance
---
apiVersion: batch/v1
kind: Job
metadata:
  name: odoo-cal-diy-v1
  namespace: odoo
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  template:
    metadata:
      labels:
        app.kubernetes.io/name: odoo-cal-diy-installer
    spec:
      automountServiceAccountToken: true
      terminationGracePeriodSeconds: 60
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      initContainers:
      - name: install-storage-addons
        image: docker.io/library/python:${ODOO_ADDON_INSTALLER_IMAGE_TAG}
        command:
        - python3
        - /config/install-addons.py
        env:
        - name: OCA_STORAGE_REVISION
          value: ${ODOO_OCA_STORAGE_REVISION}
        - name: S3FS_VERSION
          value: ${ODOO_S3FS_VERSION}
        - name: SLUGIFY_VERSION
          value: ${ODOO_SLUGIFY_VERSION}
        - name: OCA_SERVER_AUTH_REVISION
          value: ${ODOO_OCA_SERVER_AUTH_REVISION}
        - name: OCA_SERVER_TOOLS_REVISION
          value: ${ODOO_OCA_SERVER_TOOLS_REVISION}
        resources:
          requests:
            cpu: 100m
            memory: 128Mi
          limits:
            cpu: '1'
            memory: 512Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
        volumeMounts:
        - name: cal-addons
          mountPath: /cal-addons
          readOnly: true
        - name: commerce-addons
          mountPath: /commerce-addons
          readOnly: true
        - name: custom-addons
          mountPath: /custom-addons
          readOnly: true
        - name: config
          mountPath: /config
          readOnly: true
        - name: python-dependencies
          mountPath: /opt/python
        - name: addons
          mountPath: /mnt/extra-addons
      containers:
      - name: installer
        image: docker.io/library/odoo:${ODOO_IMAGE_TAG}
        command:
        - python3
        - /mnt/extra-addons/emiliany_cal_diy/maintenance/install.py
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: '2'
            memory: 2Gi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
        volumeMounts:
        - name: data
          mountPath: /var/lib/odoo
        - name: runtime-config
          mountPath: /run/odoo
        - name: python-dependencies
          mountPath: /opt/python
          readOnly: true
        - name: addons
          mountPath: /mnt/extra-addons
          readOnly: true
        - name: config
          mountPath: /config
          readOnly: true
        - name: database-credentials
          mountPath: /credentials/database
          readOnly: true
        - name: app-credentials
          mountPath: /credentials/app
          readOnly: true
        env:
        - name: PYTHONPATH
          value: /opt/python
        - name: AWS_DEFAULT_REGION
          value: ${ODOO_S3_REGION}
        - name: ODOO_S3_ENDPOINT
          value: ${ODOO_S3_ENDPOINT}
        - name: ODOO_S3_BUCKET
          value: ${ODOO_S3_BUCKET}
        - name: ODOO_S3_ATTACHMENT_PREFIX
          value: ${ODOO_S3_ATTACHMENT_PREFIX}
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: odoo-s3
              key: access-key-id
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: odoo-s3
              key: secret-access-key
        - name: MEDUSA_FULFILLMENT_URL
          value: ${ODOO_MEDUSA_FULFILLMENT_URL}
        - name: FULFILLMENT_WEBHOOK_SECRET
          valueFrom:
            secretKeyRef:
              name: odoo-medusa-fulfillment
              key: FULFILLMENT_WEBHOOK_SECRET
              optional: true
        - name: SESSION_DB_URI
          value: ${ODOO_DATABASE_NAME}
        - name: ODOO_S3_BACKUP_PREFIX
          value: ${ODOO_S3_BACKUP_PREFIX}
        - name: ODOO_CAL_DIY_BACKUP_ID
          value: __BACKUP_ID__
        - name: ODOO_CAL_DIY_MAINTENANCE_START
          value: __MAINTENANCE_START__
      volumes:
      - name: cal-addons
        configMap:
          name: odoo-cal-diy-addon
          items:
          - key: __init__.py
            path: emiliany_cal_diy/__init__.py
          - key: __manifest__.py
            path: emiliany_cal_diy/__manifest__.py
          - key: controllers____init__.py
            path: emiliany_cal_diy/controllers/__init__.py
          - key: controllers__webhook.py
            path: emiliany_cal_diy/controllers/webhook.py
          - key: data__cron.xml
            path: emiliany_cal_diy/data/cron.xml
          - key: maintenance__install.py
            path: emiliany_cal_diy/maintenance/install.py
          - key: models____init__.py
            path: emiliany_cal_diy/models/__init__.py
          - key: models__integration.py
            path: emiliany_cal_diy/models/integration.py
          - key: security__ir.model.access.csv
            path: emiliany_cal_diy/security/ir.model.access.csv
          - key: services____init__.py
            path: emiliany_cal_diy/services/__init__.py
          - key: services__api.py
            path: emiliany_cal_diy/services/api.py
          - key: services__webhook.py
            path: emiliany_cal_diy/services/webhook.py
          - key: views__integration.xml
            path: emiliany_cal_diy/views/integration.xml
      - name: commerce-addons
        configMap:
          name: odoo-commerce-addon
          items:
          - key: __init__.py
            path: medusa_bridge/__init__.py
          - key: __manifest__.py
            path: medusa_bridge/__manifest__.py
          - key: data__cron.xml
            path: medusa_bridge/data/cron.xml
          - key: models____init__.py
            path: medusa_bridge/models/__init__.py
          - key: models__fulfillment.py
            path: medusa_bridge/models/fulfillment.py
          - key: models__sale_order.py
            path: medusa_bridge/models/sale_order.py
          - key: security__groups.xml
            path: medusa_bridge/security/groups.xml
          - key: security__ir.model.access.csv
            path: medusa_bridge/security/ir.model.access.csv
          - key: views__picking.xml
            path: medusa_bridge/views/picking.xml
      - name: custom-addons
        configMap:
          name: odoo-authentik-jit-addon
          items:
          - key: authentik_jit____init__.py
            path: authentik_jit/__init__.py
          - key: authentik_jit____manifest__.py
            path: authentik_jit/__manifest__.py
          - key: authentik_jit__models____init__.py
            path: authentik_jit/models/__init__.py
          - key: authentik_jit__models__auth_oauth_provider.py
            path: authentik_jit/models/auth_oauth_provider.py
          - key: authentik_jit__models__res_users.py
            path: authentik_jit/models/res_users.py
          - key: authentik_jit__views__auth_oauth_provider_views.xml
            path: authentik_jit/views/auth_oauth_provider_views.xml
      - name: data
        emptyDir: {}
      - name: config
        configMap:
          name: odoo-config
      - name: runtime-config
        emptyDir:
          medium: Memory
      - name: database-credentials
        secret:
          secretName: odoo-db
          defaultMode: 288
      - name: app-credentials
        secret:
          secretName: odoo-app
          defaultMode: 288
      - name: python-dependencies
        emptyDir: {}
      - name: addons
        emptyDir: {}
      serviceAccountName: odoo-bootstrap
      restartPolicy: Never
