<?php

use Drupal\antalos_blog\Controller\JournalController;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_page().
 */
function antalos_journal_preprocess_page(array &$variables): void {
  $site = \Drupal::config('system.site');
  $variables['journal_site_name'] = $site->get('name');
  $route = \Drupal::routeMatch();
  $node = $route->getParameter('node');
  $variables['journal_is_article'] = $route->getRouteName() === 'entity.node.canonical' && $node instanceof NodeInterface && $node->bundle() === 'article';
  $variables['journal_is_index'] = $route->getRouteName() === 'antalos_blog.journal';
  $variables['journal_year'] = gmdate('Y');
  $variables['page']['#attached']['drupalSettings']['antalosJournal']['endpoint'] = Url::fromRoute('antalos_blog.articles')->toString();
  $variables['page']['#attached']['drupalSettings']['antalosJournal']['journalUrl'] = Url::fromRoute('antalos_blog.journal')->toString();
  CacheableMetadata::createFromRenderArray($variables['page'])->addCacheableDependency($site)->addCacheContexts(['route'])->applyTo($variables['page']);
}

/**
 * Implements hook_preprocess_node().
 */
function antalos_journal_preprocess_node(array &$variables): void {
  if ($variables['node']->bundle() !== 'article') {
    return;
  }
  $cache = CacheableMetadata::createFromRenderArray($variables);
  $variables['journal_story'] = JournalController::card($variables['node'], $cache);
  $cache->applyTo($variables);
}
