{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 25,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps[/]variables[.]yaml$/",
        "/^infrastructure[/].*[/]variables[.]yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: registryUrl=(?<registryUrl>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: depType=(?<depType>[^\\s]+))?\\r?\\n[ \\t]*[A-Za-z][A-Za-z0-9_]*:[ \\t]*[\"\\x27]?(?<currentValue>[^\\s\"\\x27@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps[/]variables[.]yaml$/",
        "/^infrastructure[/].*[/]variables[.]yaml$/"
      ],
      "matchStrings": [
        "# renovate-image: depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\r?\\n[ \\t]*[A-Za-z][A-Za-z0-9_]*:[ \\t]*[\"\\x27]?[^\\s\"\\x27]+?:(?<currentValue>[^\\s\"\\x27@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "image"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the Drupal journal React renderer and runtime on the same release",
      "matchFileNames": [
        "apps/variables.yaml"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "react",
        "react-dom"
      ],
      "groupName": "Drupal journal React"
    },
    {
      "description": "AudioMuse persistent data needs explicit PostgreSQL and Redis major migrations",
      "matchFileNames": [
        "infrastructure/ansible/leftansible/variables.yaml"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "redis"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Wait for documentation packages to clear pnpm's one-day release-age gate before generating lockfiles",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "site/package.json"
      ],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Review Nextcloud app-store releases together instead of opening one PR per add-on",
      "matchDatasources": [
        "nextcloud"
      ],
      "groupName": "Nextcloud apps"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "versioning": "docker"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/open-webui/open-webui"
      ],
      "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+$/"
    },
    {
      "description": "Checksum-pinned releases require coordinated checksum and compatibility review",
      "matchDepTypes": [
        "coordinated"
      ],
      "draftPR": true,
      "addLabels": [
        "coordinated-upgrade"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepTypes": [
        "image",
        "floating"
      ],
      "pinDigests": false
    },
    {
      "description": "Follow Zammad and Jellyfin release-line tags instead of opening PRs for each image rebuild",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/zammad/zammad",
        "jellyfin/jellyfin"
      ],
      "allowedVersions": "/^\\d+\\.\\d+$/"
    },
    {
      "description": "Follow Renovate's major channel and pull its current image for each scheduled run",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "allowedVersions": "/^\\d+$/"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/antblu/antalos-medusa"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/antblu/mautic"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>\\d+)-v(?<build>\\d+)$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "intel/pytorch"
      ],
      "versioning": "regex:^xpu-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>ubuntu\\d+\\.\\d+)-(?<build>\\d+)$"
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@medusajs[/]/"
      ],
      "groupName": "Medusa framework"
    },
    {
      "description": "Website main channels are refreshed in-cluster; keep the deployment tags mutable.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/antblu/antalos-docs",
        "ghcr.io/antblu/emiliany",
        "ghcr.io/antblu/emiliany-docs"
      ],
      "pinDigests": false
    },
    {
      "description": "Stalwart 1.x needs an explicit PostgreSQL storage migration; retain the deployed 0.16 line",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "stalwartlabs/stalwart"
      ],
      "allowedVersions": "/^v?0\\.16\\./"
    },
    {
      "description": "Follow Odoo OCA release branches without pinning their commit hashes",
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/OCA/storage.git",
        "https://github.com/OCA/server-tools.git",
        "https://github.com/OCA/server-auth.git"
      ],
      "pinDigests": false,
      "allowedVersions": "/^19\\.0$/"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^(apps|infrastructure)[/].*[.]ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^apps[/].*[/]app[.]yaml$/"
    ]
  },
  "pinDigests": false
}
